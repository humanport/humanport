<Layouts.app flash={@flash}>
  <.pane_header form={:root}>
    <:stats>0 open</:stats>
  </.pane_header>

  <div class="mx-auto max-w-2xl px-4 py-16">
    <p class="font-mono text-[length:var(--hp-text-body)] text-text-secondary">
      The HumanPort inbox is not built yet — this page exists to prove the Console token
      wiring (<code class="text-text-primary">HumanPort.UI.PaneHeader</code>, self-hosted
      JetBrains Mono / Geist, dark-by-default with a light
      <code class="text-text-primary">prefers-color-scheme</code>
      sibling) before the request domain and the inbox screens land in later plans of this phase.
    </p>
  </div>
</Layouts.app>
