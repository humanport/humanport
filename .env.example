# Copy to .env.example -> .env for a local override; .env itself is gitignored and
# refused by leak-guard by path. Defaults baked into config/dev.exs and config/test.exs
# already match the `db` service in compose.yaml, so none of the DATABASE_* variables
# below are required to run `docker compose up -d db && mix test`. They exist so a
# non-default local PostgreSQL (a different port, a different role) is still one export
# away, without editing tracked config files.

DATABASE_USERNAME=humanport
DATABASE_PASSWORD=humanport
DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_NAME=humanport_dev

# Production-only (config/runtime.exs), not needed for local development:
# DATABASE_URL=ecto://USER:PASS@HOST/DATABASE
# SECRET_KEY_BASE=  # generate with `mix phx.gen.secret`
# PHX_HOST=humanport.example.com

# Read by compose.yaml's `app` service and passed through to the container when set.
# Neither is required for `docker compose up` on a clean machine (OPS-01):
# - HUMANPORT_ACTOR_EMAIL defaults to owner@localhost (D-11) if unset.
# - SECRET_KEY_BASE, if unset, is generated at container start with a loud warning that
#   sessions will not survive a restart. Set it for anything persistent.
# HUMANPORT_ACTOR_EMAIL=owner@localhost
# SECRET_KEY_BASE=  # generate with `mix phx.gen.secret`; persists sessions across restarts

# OPS-03 — Cloudflare Access token verification (config/runtime.exs). BOTH optional; if
# neither is set, this instance behaves exactly as it does with nothing below set at all —
# the environment resolver, verified? false. If HUMANPORT_CF_ACCESS_TEAM_DOMAIN IS set,
# HUMANPORT_CF_ACCESS_AUD becomes required (the application raises at start if it is
# missing) and every request without a valid Access token is refused with 401 — including
# your own, if this instance is not actually sitting behind Cloudflare Access. Read
# docs/SELF_HOSTING.md before setting either of these on anything but a real Access
# deployment.
# HUMANPORT_CF_ACCESS_TEAM_DOMAIN=your-team-name
# HUMANPORT_CF_ACCESS_AUD=  # the AUD tag from this specific Access application's dashboard
