# Copy to .env.example -> .env for a local override; .env itself is gitignored and
# refused by leak-guard by path. Defaults baked into config/dev.exs and config/test.exs
# already match the `db` service in compose.yaml, so none of the DATABASE_* variables
# below are required to run `docker compose up -d db && mix test`. They exist so a
# non-default local PostgreSQL (a different port, a different role) is still one export
# away, without editing tracked config files.

DATABASE_USERNAME=humanport
DATABASE_PASSWORD=humanport
DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_NAME=humanport_dev

# Production-only (config/runtime.exs), not needed for local development:
# DATABASE_URL=ecto://USER:PASS@HOST/DATABASE
# SECRET_KEY_BASE=  # generate with `mix phx.gen.secret`
# PHX_HOST=humanport.example.com
