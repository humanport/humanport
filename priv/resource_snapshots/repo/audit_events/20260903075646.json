      "code?": false,
      "down": "DROP FUNCTION IF EXISTS audit_events_append_only();",
      "global?": false,
      "name": "audit_events_append_only_fn",
      "up": "CREATE OR REPLACE FUNCTION audit_events_append_only() RETURNS trigger AS $$\nBEGIN\n  RAISE EXCEPTION 'audit_events is append-only: % is not permitted', TG_OP\n    USING ERRCODE = 'integrity_constraint_violation';\nEND;\n$$ LANGUAGE plpgsql;\n"
    },
    {
      "after_tables": [
        "audit_events"
      ],
      "code?": false,
      "down": "DROP TRIGGER IF EXISTS audit_events_no_update_delete ON audit_events;",
      "global?": false,
      "name": "audit_events_no_update_delete",
      "up": "CREATE TRIGGER audit_events_no_update_delete\n  BEFORE UPDATE OR DELETE ON audit_events\n  FOR EACH ROW EXECUTE FUNCTION audit_events_append_only();\n"
    },
    {
      "after_tables": [
        "audit_events"
      ],
      "code?": false,
      "down": "DROP TRIGGER IF EXISTS audit_events_no_truncate ON audit_events;",
      "global?": false,
      "name": "audit_events_no_truncate",
      "up": "CREATE TRIGGER audit_events_no_truncate\n  BEFORE TRUNCATE ON audit_events\n  FOR EACH STATEMENT EXECUTE FUNCTION audit_events_append_only();\n"
    }
