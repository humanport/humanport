  "custom_statements": [
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP FUNCTION IF EXISTS human_requests_terminal_is_final();",
      "global?": false,
      "name": "human_requests_terminal_is_final_fn",
      "up": "CREATE OR REPLACE FUNCTION human_requests_terminal_is_final() RETURNS trigger AS $$\nBEGIN\n  IF OLD.completed_at IS NOT NULL THEN\n    RAISE EXCEPTION 'human_request % is already terminal (state=%)', OLD.id, OLD.state\n      USING ERRCODE = 'integrity_constraint_violation';\n  END IF;\n  RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql;\n"
    },
    {
      "after_tables": [
        "human_requests"
      ],
      "code?": false,
      "down": "DROP TRIGGER IF EXISTS human_requests_terminal_is_final ON human_requests;",
      "global?": false,
      "name": "human_requests_terminal_is_final_trigger",
      "up": "CREATE TRIGGER human_requests_terminal_is_final\n  BEFORE UPDATE ON human_requests\n  FOR EACH ROW EXECUTE FUNCTION human_requests_terminal_is_final();\n"
    }
  ],
